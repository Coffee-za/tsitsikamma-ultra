---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import trailLogo from '../assets/logos/trail-shop.webp';
import guLogo from '../assets/logos/gu-energy.webp';
import mtoLogo from '../assets/logos/mto-trail.webp';
import muddyLogo from '../assets/logos/muddy-foot.webp';
import ppLogo from '../assets/logos/plett-pixels.webp';
import salomonLogo from '../assets/logos/salomon.webp';
import soxLogo from '../assets/logos/sox.webp';
import saltLogo from '../assets/logos/salt.webp';

const sponsors: { src: ImageMetadata; alt: string; href: string }[] = [
	{ src: trailLogo, alt: 'The Trail Shop Logo', href: 'https://www.thebikeshop.co.za/' },
	{ src: guLogo, alt: 'GU Energy Logo', href: 'https://guenergy.co.za/' },
	{ src: mtoLogo, alt: 'MTO Trail Logo', href: 'https://www.mtotrails.com/' },
	{ src: muddyLogo, alt: 'Muddy Foot Adventures Logo', href: 'https://facebook.com/muddyfootadventures/' },
	{ src: ppLogo, alt: 'Plett Pixels Logo', href: 'https://plettpixels.com/' },
	{ src: salomonLogo, alt: 'Salomon Logo', href: 'https://salomonsports.co.za/' },
	{ src: soxLogo, alt: 'Sox Logo', href: 'https://soxfootwear.co.za/' },
	{ src: saltLogo, alt: 'Salt Logo', href: 'https://saltplettenbergbay.co.za/' },
];

const carouselSponsors = [...sponsors, ...sponsors];
---

<section id="sponsors" class="section sponsors">
	<div class="container">
		<h2 class="section-title">Our Sponsors</h2>
		<div class="sponsors-carousel">
			<div class="sponsors-track">
				{carouselSponsors.map((sponsor) => (
					<div class="sponsor-logo">
						<a href={sponsor.href} target="_blank" rel="noopener noreferrer">
							<Image src={sponsor.src} alt={sponsor.alt} width={200} loading="lazy" />
						</a>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.sponsors {
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.02) 0%, var(--background-color) 100%);
		overflow: hidden;
	}

	.sponsors-carousel {
		width: 100%;
		overflow: hidden;
		position: relative;
		background: rgba(255, 255, 255, 0.02);
		border-radius: 12px;
		padding: 2rem 0;
	}

	.sponsors-track {
		display: flex;
		align-items: center;
		animation: scroll 30s linear infinite;
		width: calc(250px * 16 + 3rem * 16); /* 16 logos with gaps */
	}

	.sponsor-logo {
		flex-shrink: 0;
		width: 250px;
		height: 120px;
		margin-right: 3rem;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.9);
		border-radius: 8px;
		padding: 0.5rem;
		transition: transform 0.3s ease;
	}

	.sponsor-logo:hover {
		transform: scale(1.05);
	}

	.sponsor-logo a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}
	.sponsor-logo img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		transition: filter 0.3s ease;
	}

	@keyframes scroll {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(calc(-250px * 8 - 3rem * 8)); /* Move by width of 8 logos */
		}
	}

	/* Pause animation on hover */
	.sponsors-carousel:hover .sponsors-track {
		animation-play-state: paused;
	}

	@media (max-width: 768px) {
		.sponsor-logo {
			width: 180px;
			height: 90px;
			margin-right: 2rem;
			padding: 0.25rem;
		}

		.sponsors-track {
			width: calc(180px * 16 + 2rem * 16);
		}

		@keyframes scroll {
			0% {
				transform: translateX(0);
			}
			100% {
				transform: translateX(calc(-180px * 8 - 2rem * 8));
			}
		}
	}
</style>
